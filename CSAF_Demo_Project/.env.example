# Copy this file to .env in the project root or backend/ and fill in local values.
# Never commit a real GEMINI_API_KEY.

# Required for Gemini mode. Leave empty to stay in deterministic mock mode.
GEMINI_API_KEY=

# Model name used by GeminiAgentProvider. Ignored in mock mode.
GEMINI_MODEL=gemini-2.0-flash

# mock | gemini
# If gemini is selected but GEMINI_API_KEY is missing, the app stays in mock mode.
AGENT_PROVIDER=mock

# SQLAlchemy URL. The foundation uses a local SQLite file.
DATABASE_URL=sqlite:///./nozama.db
